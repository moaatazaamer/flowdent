# Copy to .env (git-ignored) or export these in your shell before starting backend-service.
# All values below are placeholders — never commit real keys.

# MySQL
DB_URL=jdbc:mysql://localhost:3306/ecommerce_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=root

# JWT (at least 32 characters)
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRATION=86400000

# Stripe TEST keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_CURRENCY=egp

# Image upload folder (relative to where backend-service runs)
UPLOAD_DIR=uploads
